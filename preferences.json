[
  {
    "property": "extension.ask-on-page.findbar-ai.enabled",
    "label": "Enable Findbar AI",
    "type": "checkbox",
    "defaultValue": true,
    "description": "Globally enables or disables the AI-powered findbar."
  },
  {
    "type": "separator",
    "id": "ask-on-page-api-separator",
    "label": "API Configuration"
  },
  {
    "property": "extension.ask-on-page.llm-provider",
    "label": "AI Provider",
    "type": "dropdown",
    "defaultValue": "gemini",
    "description": "Select the AI service provider to use.",
    "options": [
      {
        "value": "claude",
        "label": "Anthropic Claude"
      },
      {
        "value": "gemini",
        "label": "Google Gemini"
      },
      {
        "value": "mistral",
        "label": "Mistral AI"
      },
      {
        "value": "ollama",
        "label": "Ollama (local)"
      },
      {
        "value": "openai",
        "label": "OpenAI GPT"
      },
      {
        "value": "openrouter",
        "label": "OpenRouter"
      }
    ]
  },
  {
    "property": "extension.ask-on-page.claude-api-key",
