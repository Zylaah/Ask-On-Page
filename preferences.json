  {
    "property": "extension.ask-on-page.findbar-ai.context-menu-enabled",
    "label": "Enable Context Menu Item",
    "type": "checkbox",
    "defaultValue": true,
    "description": "Adds an 'Ask AI' / 'Summarize with AI' option to the right-click context menu.",
    "conditions": [
      {
        "if": {
          "property": "extension.ask-on-page.findbar-ai.enabled",
          "value": true
        }
      }
    ]
  },
  {
    "property": "extension.ask-on-page.findbar-ai.context-menu-autosend",
    "label": "Automatically Send Query from Context Menu",
    "type": "checkbox",
    "defaultValue": true,
    "description": "If enabled, clicking the context menu item immediately sends the query. If disabled, it only populates the input field.",
    "conditions": [
      {
        "if": {
          "property": "extension.ask-on-page.findbar-ai.enabled",
          "value": true
        }
      },
      {
        "if": {
          "property": "extension.ask-on-page.findbar-ai.context-menu-enabled",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "property": "extension.ask-on-page.findbar-ai.context-menu-command-no-selection",
    "label": "Context Menu Command (No Selection)",
    "type": "string",
    "defaultValue": "Summarize current page",
    "description": "The command to send to the AI when the context menu is used without any text selected.",
    "conditions": [
      {
        "if": {
          "property": "extension.ask-on-page.findbar-ai.enabled",
          "value": true
        }
      },
      {
        "if": {
          "property": "extension.ask-on-page.findbar-ai.context-menu-enabled",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "property": "extension.ask-on-page.findbar-ai.context-menu-command-with-selection",
    "label": "Context Menu Command (With Selection)",
    "type": "string",
    "defaultValue": "Explain this in context of current page:\n\n{selection}",
