  {
    "property": "extension.ask-on-page.llm.temperature",
    "label": "Temperature",
    "type": "dropdown",
    "defaultValue": 0.7,
    "description": "Controls randomness: Lower values result in less random completions.",
    "options": [
      {
        "value": 0.0,
        "label": "0.0 (Very Deterministic)"
      },
      {
        "value": 0.1,
        "label": "0.1"
      },
      {
        "value": 0.3,
        "label": "0.3"
      },
      {
        "value": 0.5,
        "label": "0.5"
      },
      {
        "value": 0.7,
        "label": "0.7 (Balanced)"
      },
      {
        "value": 1.0,
        "label": "1.0 (Very Creative)"
      }
    ]
  },
  {
    "property": "extension.ask-on-page.llm.top-p",
    "label": "Top P",
    "type": "dropdown",
    "defaultValue": 1.0,
    "description": "Nucleus sampling: limits token selection to top cumulative probability.",
    "options": [
      {
        "value": 0.1,
        "label": "0.1 (Very Restrictive)"
      },
      {
        "value": 0.3,
        "label": "0.3"
      },
      {
        "value": 0.5,
        "label": "0.5"
      },
      {
        "value": 0.7,
        "label": "0.7"
      },
      {
        "value": 0.9,
        "label": "0.9"
      },
      {
        "value": 0.95,
        "label": "0.95"
      },
      {
        "value": 1.0,
        "label": "1.0 (No Limit)"
      }
    ]
  },
  {
    "property": "extension.ask-on-page.llm.top-k",
